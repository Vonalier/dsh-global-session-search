{
  "name": "dsh-global-session-search",
  "version": "0.2.2",
  "private": false,
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "type": "module",
  "description": "Search every DSH conversation across all workspaces and all records.",
  "license": "MIT",
  "author": "Vonalier",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vonalier/dsh-global-session-search.git"
  },
  "homepage": "https://github.com/Vonalier/dsh-global-session-search",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale"]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ]
}
